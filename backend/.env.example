# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/street-vendor-agent

# IBM Cloud Configuration (Required for IBM Granite)
IBM_GRANITE_API_KEY=your_ibm_granite_api_key
IBM_GRANITE_PROJECT_ID=your_ibm_project_id
IBM_GRANITE_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Translation Service (Optional)
TRANSLATION_API_KEY=optional_translation_api_key

# Geolocation Configuration
GEOLOCATION_API_KEY=optional_geolocation_api_key

# QR Code Configuration
QR_CODE_SIZE=200

# Knowledge Base Update Frequency (in hours)
KB_UPDATE_FREQUENCY=24

# Cache Configuration
CACHE_TTL=3600

# Logging
LOG_LEVEL=info

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password
SENDER_EMAIL=noreply@vendor-agent.local

# Features Flag
ENABLE_MULTI_LANGUAGE=true
ENABLE_GEOLOCATION=true
ENABLE_RAG_CACHING=true
ENABLE_AUTO_PROFILE_GENERATION=true
